<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs/FindSecBugs 已知合理告警排除清单（其余规则照跑）。

  逐项理由：
  - EI_EXPOSE_REP / EI_EXPOSE_REP2：ModelProperties 是 @ConfigurationProperties 配置 bean，
    Spring 需要可变 setter 完成属性绑定，防御性拷贝会破坏绑定；LlmClient/ModelService 的构造注入
    是 Spring 单例 DI 常规写法。属设计使然的误报。
  - VA_PRIMITIVE_ARRAY_PASSED_TO_OBJECT_VARARG：OnnxTensor.createTensor 存在 Object varargs 重载，
    SpotBugs 匹配到该重载误判；实际绑定到具体 long[][] 重载，真实 BGE 推理单测已验证通过。
  - REC_CATCH_EXCEPTION：EmbeddingClient.load() 统一 catch 包装加载失败为 IllegalStateException，
    需兼容 OrtException/IOException/tokenizer 异常等多种受检异常，属有意为之。
  - CRLF_INJECTION_LOGS：日志参数（model 名等）来自受控环境变量/配置，非不可信外部输入。
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="VA_PRIMITIVE_ARRAY_PASSED_TO_OBJECT_VARARG"/>
  </Match>
  <Match>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <Match>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
  </Match>
  <Match>
    <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
  </Match>
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
</FindBugsFilter>

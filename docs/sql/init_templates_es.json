{"user_id":1,"name":"岗位招聘JD模板","description":"撰写结构清晰、有吸引力的岗位招聘描述","structure":"# ${job_title}（${headcount} 名）\n\n## 职位概述\n${overview}\n\n## 岗位职责\n${responsibility}\n\n## 任职要求\n${requirement}\n\n## 加分项\n${plus}\n\n## 团队/部门\n${department}","variables":[{"key":"job_title","label":"岗位名称","type":"text","required":true,"placeholder":"如：Java 后端工程师","options":[]},{"key":"department","label":"所属团队","type":"text","required":true,"placeholder":"如：平台研发部","options":[]},{"key":"headcount","label":"招聘人数","type":"number","required":false,"placeholder":"如：2","options":[]},{"key":"overview","label":"职位概述","type":"textarea","required":true,"placeholder":"一句话描述岗位价值","options":[]},{"key":"responsibility","label":"岗位职责","type":"textarea","required":true,"placeholder":"分条列出核心职责","options":[]},{"key":"requirement","label":"任职要求","type":"textarea","required":true,"placeholder":"分条列出硬性要求","options":[]},{"key":"plus","label":"加分项","type":"textarea","required":false,"placeholder":"可选加分能力","options":[]}],"prompt":"JD 语言专业有吸引力：职责聚焦结果，要求匹配可衡量标准，避免夸大；整体结构清晰、便于求职者快速抓取重点。","status":"enabled","create_time":1791216000000,"update_time":1791216000000}


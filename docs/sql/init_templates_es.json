{"user_id":1,"name":"会议纪要模板","description":"沉淀会议议题、结论与行动项，适合会后产出纪要","structure":"# ${meeting_topic}\n\n- 会议时间：${meeting_date}\n- 参会人：${attendees}\n\n## 一、会议结论\n${decisions}\n\n## 二、行动项\n${actions}\n\n## 三、遗留问题\n${open_issues}","variables":[{"key":"meeting_topic","label":"会议主题","type":"text","required":true,"placeholder":"如：Q3 产品规划评审会","options":[]},{"key":"meeting_date","label":"会议时间","type":"text","required":true,"placeholder":"如：2026-10-06 14:00","options":[]},{"key":"attendees","label":"参会人","type":"textarea","required":true,"placeholder":"逐行列出参会人员","options":[]},{"key":"decisions","label":"会议结论","type":"textarea","required":true,"placeholder":"列出已达成一致的结论","options":[]},{"key":"actions","label":"行动项","type":"textarea","required":true,"placeholder":"每条写明：事项 / 负责人 / 截止时间","options":[]},{"key":"open_issues","label":"遗留问题","type":"textarea","required":false,"placeholder":"尚未达成一致的议题","options":[]}],"prompt":"按纪要格式整理：结论先行，行动项明确责任人与时间，语言精炼客观，不夹带个人情绪。","status":"enabled","create_time":1791216000000,"update_time":1791216000000}

{"user_id":1,"name":"产品发布文案模板","description":"面向目标受众撰写产品发布宣传文案，适合公众号/官网/社媒","structure":"# ${product_name} 发布文案\n\n## 一、一句话卖点\n${punchline}\n\n## 二、核心亮点\n${highlights}\n\n## 三、目标受众\n${target_audience}\n\n## 四、行动号召\n${call_to_action}","variables":[{"key":"product_name","label":"产品名称","type":"text","required":true,"placeholder":"如：ScriptAgent 写作助手","options":[]},{"key":"punchline","label":"一句话卖点","type":"text","required":true,"placeholder":"提炼最打动人的一句","options":[]},{"key":"highlights","label":"核心亮点","type":"textarea","required":true,"placeholder":"分条列出 3-5 个差异化亮点","options":[]},{"key":"target_audience","label":"目标受众","type":"select","required":true,"placeholder":"选择受众类型","options":["C端个人用户","B端企业客户","开发者","运营团队"]},{"key":"call_to_action","label":"行动号召","type":"text","required":false,"placeholder":"如：立即免费体验 → www.example.com","options":[]}],"prompt":"文案风格贴合所选受众：C端偏感性易读，B端偏价值与数据，开发者偏技术细节；突出用户收益而非功能堆砌；结尾自然引导行动。","status":"enabled","create_time":1791216000000,"update_time":1791216000000}

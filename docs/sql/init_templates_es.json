# ============================================================================
# ScriptAgent (wordpilot) 模板库初始化数据 —— ES writing_template 索引
# 用途: 为 admin 用户预置一批模板，便于前端工作台"模板管理/模板写作"演示与联调
# 载体: ES bulk (x-ndjson)，每两行一对(索引动作行 + 文档行)，禁止尾随空行
# 归属: user_id = 1 (admin)。若实际库中 admin 主键非 1，请先执行
#       SELECT id FROM sys_user WHERE username='admin' 确认后批量替换本文件 user_id。
# 时间: create_time/update_time 为 epoch millis，取 2026-10-06 00:00:00 (UTC+8) = 1791216000000
# 执行: 见文件尾部 "用法"（ES 地址按实际 application.yaml 配置替换）
# ============================================================================

{"index":{"_index":"writing_template","_id":"tpl-weekly-report"}}
{"user_id":1,"name":"周报模板","description":"按周汇总本周工作、下周计划与风险，适合团队周度汇报","structure":"# ${title}\n\n## 一、本周工作\n${week_work}\n\n## 二、下周计划\n${next_plan}\n\n## 三、风险与求助\n${risk}\n\n## 四、本周重点\n${priority}","variables":[{"key":"title","label":"周报标题","type":"text","required":true,"placeholder":"如：张三 第X周工作周报","options":[]},{"key":"week_work","label":"本周工作","type":"textarea","required":true,"placeholder":"分条列出本周完成事项，突出结果与数据","options":[]},{"key":"next_plan","label":"下周计划","type":"textarea","required":true,"placeholder":"列出下周重点安排与预期产出","options":[]},{"key":"risk","label":"风险与求助","type":"textarea","required":false,"placeholder":"如遇阻塞或需协调事项请写明","options":[]},{"key":"priority","label":"本周重点","type":"select","required":false,"placeholder":"选择本周重心","options":["高","中","低"]}],"prompt":"用简洁条目式语言重写周报：每条工作给出进展、结果与下一步；优先使用数据支撑；避免空话套话；风险部分给出影响与建议动作。","status":"enabled","create_time":1791216000000,"update_time":1791216000000}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Google Java Style Checkstyle 配置（兜底层）.

  真正的格式统一由 Spotless + google-java-format 在 verify 阶段完成；
  本文件用于在 IDE / CI 中跑 Checkstyle 时给出基本风格约束，
  仅保留与 Google Style 一致且与 Spotless 不重复的必要规则.
-->
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- 禁止 System.out / System.err（由阿里 P3C / SpotBugs 覆盖） -->
    <module name="RegexpSingleline">
        <property name="format" value="System\.(out|err)\.print"/>
        <property name="message" value="禁止使用 System.out / System.err，请用 SLF4J Logger"/>
        <property name="severity" value="error"/>
    </module>

    <!-- 禁止 tab 缩进 -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- 文件末尾换行 -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>

    <module name="TreeWalker">
        <!-- import 禁止使用通配符 -->
        <module name="AvoidStarImport"/>
        <!-- 未使用 import -->
        <module name="UnusedImports"/>
        <!-- 重载方法必须相邻 -->
        <module name="OverloadMethodsDeclarationOrder"/>
    </module>
</module>